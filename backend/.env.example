# ============================================
# YE FILE COPY KARKE ".env" NAAM SE SAVE KARO
# ============================================

# Google Gemini API Key — aistudio.google.com se FREE milegi (card nahi chahiye)
GEMINI_API_KEY=your_gemini_api_key_here

# Meta (Facebook/Instagram) — baad mein Meta Developer Account banne ke baad
META_ACCESS_TOKEN=
META_PAGE_ID=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Business info
BUSINESS_NAME=My Business
BUSINESS_NICHE=General products
BRAND_TONE=Friendly and professional

# Database
DATABASE_URL=sqlite:///./smm_agent.db

# Frontend ka URL (CORS ke liye)
FRONTEND_URL=http://localhost:3000
